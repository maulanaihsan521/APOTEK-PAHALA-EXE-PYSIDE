# ==== Apotek Pahala - konfigurasi lingkungan ====
# Salin file ini menjadi .env sebelum menjalankan aplikasi.
# Jangan menyimpan secret asli pada repositori.

# Kunci JWT. Jika dikosongkan, aplikasi membuat kunci acak di storage/secret.key.
SECRET_KEY=

# Lokasi database dan folder penyimpanan (opsional, default di root proyek).
# APOTEK_DB_PATH=C:/path/ke/apotek_pahala.db
# APOTEK_STORAGE_DIR=C:/path/ke/storage
# APOTEK_MODEL_DIR=C:/path/ke/models
# APOTEK_BACKUP_DIR=C:/path/ke/backups

# Token berlaku 12 jam (menit).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Backend
APOTEK_HOST=0.0.0.0
APOTEK_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
